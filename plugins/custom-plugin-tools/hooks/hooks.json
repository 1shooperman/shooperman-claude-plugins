{
  "description": "custom-plugin-tools plugin hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/hooks/scripts/session-time.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
