{
  "description": "GBL plugin hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PLUGIN_ROOT/hooks/scripts/session-time.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
